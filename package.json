{
  "name": "@amlhubs/fipa-ip",
  "version": "0.0.1",
  "description": "IEEE FIPA Interaction Protocol Library — typed TypeScript implementation of the 11 named coordination protocols (Request, Query, Request-When, Contract Net, Iterated Contract Net, English/Dutch Auction, Brokering, Recruiting, Subscribe, Propose) defined by FIPA SC0002{6..36} (2002-12). Builds on @amlhubs/fipa-acl Performative + ACLMessage envelope; depends on uml + ocl.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@amlhubs/fipa-acl": "^0.0.1",
    "@amlhubs/uml": ">=0.0.1",
    "@amlhubs/ocl": "^0.0.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amlhubs/fipa-ip.git",
    "directory": "."
  },
  "keywords": [
    "fipa",
    "fipa-ip",
    "ieee",
    "interaction-protocol",
    "multi-agent",
    "agent-coordination",
    "contract-net",
    "metamodel",
    "agentic-modeling-language",
    "aml",
    "agenihub",
    "amlhubs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@amlhubs/fipa-acl": "^0.0.1",
    "@amlhubs/uml": "^0.0.2",
    "@amlhubs/ocl": "^0.0.1",
    "typescript": "^5.5.0"
  }
}
